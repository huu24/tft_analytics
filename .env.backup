# TFT Analytics - Environment Configuration
# Copy this file to .env and adjust values as needed

# ── Airflow Configuration ──
AIRFLOW_UID=50000
AIRFLOW_GID=0
AIRFLOW_HOME=/opt/airflow
AIRFLOW__CORE__EXECUTOR=CeleryExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=true

# Admin credentials
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@tft-analytics.local

# ── Redis (Celery Broker) ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ── MinIO / S3 (Iceberg Warehouse) ──
MINIO_ENDPOINT=http://host.docker.internal:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password123
MINIO_BUCKET=lakehouse-bucket
S3A_WAREHOUSE=s3a://lakehouse-bucket/warehouse

# ── Spark / Iceberg ──
SPARK_APP_NAME=TFT_Analytics_ETL
ICEBERG_CATALOG=lakehouse
ICEBERG_WAREHOUSE=s3a://lakehouse-bucket/warehouse
SPARK_JARS_PACKAGES=org.apache.iceberg:iceberg-spark-runtime-3.4_2.12:1.4.2,org.apache.hadoop:hadoop-aws:3.3.4

# ── SMTP / Email Alerts (MailHog for testing) ──
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_SSL=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=airflow@tft-analytics.local
ALERT_EMAIL_RECIPIENT=admin@tft-analytics.local

# ── ETL Schedule ──
ETL_SCHEDULE_INTERVAL=*/5 * * * *
ETL_SLA_MINUTES=10
ETL_RETRY_DELAY_MINUTES=5
ETL_MAX_RETRIES=3

# ── Monitoring ──
ENABLE_PROMETHEUS=false
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# ── Slack Alerts (Optional) ──
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

